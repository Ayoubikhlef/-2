generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CUSTOMER
}

model User {
  id               String      @id @default(cuid())
  email            String      @unique
  passwordHash     String
  name             String
  phone            String?
  avatar           String?
  role             Role        @default(CUSTOMER)
  isActive         Boolean     @default(true)
  twoFactorSecret  String?
  refreshToken     String?
  resetToken       String?     @unique
  resetTokenExpires DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  addresses        Address[]
  orders           Order[]
  reviews          Review[]
}

model Address {
  id          String @id @default(cuid())
  userId      String
  label       String?
  fullName    String
  phone       String
  wilaya      String
  municipality String
  address     String
  isDefault   Boolean @default(false)
  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id          String   @id @default(cuid())
  nameAr      String
  nameFr      String
  nameEn      String
  descAr      String
  descFr      String
  descEn      String
  shortDescAr String?
  shortDescFr String?
  shortDescEn String?
  price       Float
  salePrice   Float?
  saleEnd     DateTime?
  sku         String   @unique
  barcode     String?
  stock       Int      @default(0)
  categoryId  String?
  brand       String?
  weight      Float?
  dimensions  String?
  warranty    String?
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category? @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  reviews     Review[]
  orderItems  OrderItem[]
}

model Category {
  id       String    @id @default(cuid())
  nameAr   String
  nameFr   String
  nameEn   String
  slug     String    @unique
  icon     String?
  parentId String?

  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")
  products  Product[]
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id             String   @id @default(cuid())
  userId         String?
  customer       String
  phone          String
  email          String?
  wilaya         String
  municipality   String
  address        String
  note           String?
  total          Float
  subtotal       Float?
  wilayaId       Int?
  deliveryFee    Float    @default(0)
  deliveryMethod String?
  status         String   @default("new")
  paymentMethod  String?
  paymentStatus  String?
  trackingNumber String?
  source         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User?       @relation(fields: [userId], references: [id])
  items    OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String?
  name      String
  quantity  Int
  price     Float
  total     Float

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  type       String    @default("percentage")
  value      Float
  minAmount  Float     @default(0)
  maxUses    Int       @default(0)
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model NewsletterSubscriber {
  email     String   @id
  createdAt DateTime @default(now()) @map("created_at")

  @@map("aos_newsletter")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Website factory
// ---------------------------------------------------------------------------

model SiteTemplate {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameAr    String
  nameFr    String
  nameEn    String
  descAr    String
  descFr    String
  descEn    String
  category  String   @default("company")
  accent    String   @default("#0b5ed7")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SitePackage {
  id           String   @id @default(cuid())
  slug         String   @unique
  nameAr       String
  nameFr       String
  nameEn       String
  descAr       String
  descFr       String
  descEn       String
  price        Float
  oldPrice     Float?
  features     Json?
  deliveryDays Int      @default(3)
  revisions    Int      @default(2)
  isPopular    Boolean  @default(false)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteRequest {
  id             String   @id @default(cuid())
  ref            String   @unique
  templateSlug   String
  packageSlug    String
  status         String   @default("new")
  siteName       String
  businessName   String?
  category       String?
  tagline        String?
  description    String?
  phone          String
  email          String?
  whatsapp       String?
  address        String?
  city           String?
  language       String   @default("ar")
  primaryColor   String   @default("#0b5ed7")
  secondaryColor String   @default("#1e3a8a")
  logoUrl        String?  @db.Text
  coverUrl       String?  @db.Text
  socials        Json?
  hours          Json?
  content        Json?
  subdomain      String   @unique
  customDomain   String?
  price          Float    @default(0)
  paymentMethod  String?
  paymentRef     String?
  receiptUrl     String?  @db.Text
  receiptName    String?
  adminNote      String?
  previewUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site   Site?
  events SiteRequestEvent[]

  @@index([status, createdAt])
  @@index([subdomain])
}

model SiteRequestEvent {
  id        String   @id @default(cuid())
  requestId String
  type      String
  message   String
  createdAt DateTime @default(now())

  request SiteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model Site {
  id             String    @id @default(cuid())
  requestId      String?   @unique
  subdomain      String    @unique
  customDomain   String?
  name           String
  templateSlug   String
  status         String    @default("preview")
  config         Json?
  files          Json?
  url            String?
  deployedUrl    String?
  publishedAt    DateTime?
  lastDeployAt   DateTime?
  deployProvider String?
  deployError    String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  request  SiteRequest?  @relation(fields: [requestId], references: [id])
  products SiteProduct[]
  orders   SiteOrder[]
  leads    SiteLead[]
  builds   SiteBuild[]

  @@index([status, createdAt])
}

model SiteProduct {
  id          String   @id @default(cuid())
  siteId      String
  name        String
  description String?
  price       Float    @default(0)
  imageUrl    String?  @db.Text
  category    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, sortOrder])
}

model SiteOrder {
  id           String   @id @default(cuid())
  siteId       String
  ref          String   @unique
  customerName String
  phone        String
  wilaya       String
  city         String?
  address      String
  note         String?
  items        Json
  total        Float
  status       String   @default("new")
  createdAt    DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@index([status])
}

model SiteLead {
  id        String   @id @default(cuid())
  siteId    String
  name      String
  phone     String?
  email     String?
  message   String
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}

model SiteBuild {
  id        String   @id @default(cuid())
  siteId    String
  status    String
  provider  String
  url       String?
  error     String?  @db.Text
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}


