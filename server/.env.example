# Server (Render / local)
PORT=3001
NODE_ENV=development

# Database (PostgreSQL - get from Render Dashboard → PostgreSQL)
# Local: DATABASE_URL="postgresql://user:pass@localhost:5432/aos"
DATABASE_URL="postgresql://user:pass@host:5432/aos"

# JWT - generate strong random strings: openssl rand -hex 32
JWT_SECRET="change-this-to-a-random-secret"
JWT_REFRESH_SECRET="change-this-to-another-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS - frontend URL (Vercel or local), comma-separated if multiple
CORS_ORIGIN="http://localhost:5173,https://aostech.vercel.app"

# Seed - password for initial admin account
# SEED_ADMIN_PASSWORD="your-strong-password"

# Admin panel unlock code (shown in AdminGate screen) - set any secret value
ADMIN_GATE_CODE="change-me"

# WhatsApp Meta Cloud API (https://developers.facebook.com/apps → your app → WhatsApp → API Setup)
# WHATSAPP_WEBHOOK_URL="https://graph.facebook.com/v21.0/<PHONE_NUMBER_ID>/messages"
# WHATSAPP_ACCESS_TOKEN="EAAG...your-token"
# ADMIN_WHATSAPP="213674113290"

# SMTP - email sending (SendGrid, Gmail, Mailgun, etc.)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.your_api_key