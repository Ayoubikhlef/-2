# Server (Render / local)
PORT=3001
NODE_ENV=development

# Database (PostgreSQL - get from Render Dashboard → PostgreSQL)
# Local: DATABASE_URL="postgresql://user:pass@localhost:5432/aos"
DATABASE_URL="postgresql://user:pass@host:5432/aos"

# JWT - generate strong random strings: openssl rand -hex 32
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-a-different-32-character-random-secret"
API_PUBLIC_URL="https://aostech.vercel.app/api"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS - frontend URL (Vercel or local), comma-separated if multiple
CORS_ORIGIN="http://localhost:5173,https://aostech.vercel.app"

# Seed admin (REQUIRED in production)
# Use a long unique password. Changes are applied on the next server start.
# SEED_ADMIN_EMAIL="hydra"
# SEED_ADMIN_PASSWORD=""

# Admin panel unlock code (shown in AdminGate screen) - set any long secret value
ADMIN_GATE_CODE=""

# WhatsApp Meta Cloud API (https://developers.facebook.com/apps → your app → WhatsApp → API Setup)
# WHATSAPP_WEBHOOK_URL="https://graph.facebook.com/v21.0/<PHONE_NUMBER_ID>/messages"
# WHATSAPP_ACCESS_TOKEN="EAAG...your-token"
# ADMIN_WHATSAPP="213674113290"

# SMTP - email sending (SendGrid, Gmail, Mailgun, etc.)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.your_api_key

# Customer accounts - confirmation emails
# PUBLIC_SITE_URL is used in the links inside those emails.
PUBLIC_SITE_URL="https://aos-tech.store"
# Sender identity. In production it must be an address on a domain verified in
# Resend (or the authenticated SMTP mailbox). Customer registration stays
# disabled until a transactional mail provider is configured.
# MAIL_FROM="AOS Tech Store <no-reply@aos-tech.store>"

# Social sign-in for customer accounts (Google / GitHub).
# Admin accounts are refused by the callback and must use #hqpanel.
# Register these exact redirect URIs in each provider console:
#   Google: https://aos-tech.store/api/auth/oauth/google/callback
#   GitHub: https://aos-tech.store/api/auth/oauth/github/callback
# A provider stays hidden on the login page until both of its values are set.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# Optional: override the public API base used to build the callback URL when
# the API is not served under the storefront domain.
# OAUTH_CALLBACK_BASE="https://aos-tech.store/api"

# Security alerts (recommended in production)
# Email channel. Render Free blocks outbound SMTP ports (25, 465, 587),
# so use an HTTPS email API there. Create a free key at https://resend.com:
# RESEND_API_KEY="re_..."
# Recipient for security alerts. Falls back to SMTP_USER when it is an email address.
# SECURITY_ALERT_EMAIL="you@example.com"
# Optional sender. With a Resend test key the default only delivers to your Resend account email.
# SECURITY_ALERT_FROM="AOS Security <onboarding@resend.dev>"
# SMTP (used automatically when RESEND_API_KEY is not set; works locally / paid Render)
# Telegram: create a bot with @BotFather, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Optional extra channel
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
# Set to "false" to disable temporary IP blocking (alerts keep working)
SECURITY_AUTO_BLOCK="true"

# AI Studio (text generation inside the digital services section) — optional.
# The key stays on the server; the browser never receives it.
# Recommended free tier: Gemini → https://aistudio.google.com/app/apikey
# Claude / other models through OpenRouter → https://openrouter.ai/keys
# AI_PROVIDER="gemini"          # gemini | openrouter | groq | openai (or any OpenAI-compatible)
# AI_API_KEY=""
# OPENROUTER_API_KEY=""         # when set, it runs first unless AI_PROVIDER names another provider
# AI_MODEL="gemini-3.5-flash-lite"   # defaults: gemini-3.5-flash-lite / claude-haiku-5.5 / llama-3.3-70b-versatile / gpt-4o-mini
# AI_BASE_URL=""                # override for a custom OpenAI-compatible endpoint
# AI_DAILY_LIMIT="200"          # soft per-process daily cap protecting the free quota
# AI_TIMEOUT_MS="20000"         # keyed provider timeout before the free fallback
# AI_ALLOW_KEYLESS="1"          # with no key, use the free keyless provider (set 0 to disable)
# AI_KEYLESS_MODEL="kilo-auto/free"
# AI_KEYLESS_BASE_URL="https://api.kilo.ai/api/gateway"
# Set to "1" to answer with a local sample (UI testing, no provider call)
# AI_MOCK="0"

# Salt used to hash visitor IPs for the AI free-trial counter.
# Falls back to JWT_SECRET when empty; set a separate random value in production.
# AI_IP_SALT=""

# Public visitor counter (footer + admin overview). Set an offset only if the
# store already had traffic before the counter table existed; default 0.
# Visitor ids are salted hashes (AI_IP_SALT), never raw IPs.
# VISIT_BASE_COUNT="0"

# Encrypted backups. BACKUP_ENCRYPTION_KEY must be at least 32 characters; it
# never leaves the server. Keep a copy in a password manager, because a backup
# cannot be restored without it. The admin panel downloads the encrypted file.
# BACKUP_ENCRYPTION_KEY=""
# Run one backup per day at BACKUP_HOUR_UTC (default 3). Render's free disk is
# ephemeral, so download the file or configure the GitHub destination below.
# BACKUP_AUTO="true"
# BACKUP_HOUR_UTC="3"
# BACKUP_DIR="./backups"
# BACKUP_KEEP="7"
# Optional off-server destination: a private repo and a fine-grained token with
# "Contents: Read and write". The file is AES-256-GCM encrypted before upload.
# BACKUP_GITHUB_REPO="owner/private-repo"
# BACKUP_GITHUB_TOKEN=""
# BACKUP_GITHUB_PATH="backups"
# BACKUP_GITHUB_BRANCH=""

# Chargily Pay v2 (https://pay.chargily.dz) - card payments for AI subscriptions.
# The secret key must be the LIVE or TEST secret from the Chargily dashboard.
# Without these keys the site still sells subscriptions through CCP/BaridiMob
# and the admin activates them after reviewing the receipt.
# CHARGILY_SECRET_KEY=""
# CHARGILY_MODE="test"          # test | live
# Webhook endpoint to register in Chargily: https://aos-tech.store/api/subscription/chargily/webhook
# CHARGILY_WEBHOOK_SECRET=""    # optional: the same secret key signs webhook payloads

# Cloudflare Turnstile - customer login only (the admin panel is exempt because
# it enforces two-factor authentication and must stay reachable during an
# outage). Create the widget at Cloudflare Dashboard -> Turnstile, then set:
#   TURNSTILE_SECRET_KEY on Render (secret)
#   VITE_TURNSTILE_SITE_KEY in the Vercel build environment (public)
# Leave both empty to keep the widget hidden and skip verification.
# TURNSTILE_SECRET_KEY=""
