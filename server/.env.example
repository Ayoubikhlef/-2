# Server (Render / local)
PORT=3001
NODE_ENV=development

# Database (PostgreSQL - get from Render Dashboard → PostgreSQL)
# Local: DATABASE_URL="postgresql://user:pass@localhost:5432/aos"
DATABASE_URL="postgresql://user:pass@host:5432/aos"

# JWT - generate strong random strings: openssl rand -hex 32
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-a-different-32-character-random-secret"
API_PUBLIC_URL="https://aostech.vercel.app/api"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS - frontend URL (Vercel or local), comma-separated if multiple
CORS_ORIGIN="http://localhost:5173,https://aostech.vercel.app"

# Seed admin (REQUIRED in production)
# Use a long unique password. Changes are applied on the next server start.
# SEED_ADMIN_EMAIL="hydra"
# SEED_ADMIN_PASSWORD=""

# Admin panel unlock code (shown in AdminGate screen) - set any long secret value
ADMIN_GATE_CODE=""

# WhatsApp Meta Cloud API (https://developers.facebook.com/apps → your app → WhatsApp → API Setup)
# WHATSAPP_WEBHOOK_URL="https://graph.facebook.com/v21.0/<PHONE_NUMBER_ID>/messages"
# WHATSAPP_ACCESS_TOKEN="EAAG...your-token"
# ADMIN_WHATSAPP="213674113290"

# SMTP - email sending (SendGrid, Gmail, Mailgun, etc.)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.your_api_key

# Security alerts (recommended in production)
# Email channel. Render Free blocks outbound SMTP ports (25, 465, 587),
# so use an HTTPS email API there. Create a free key at https://resend.com:
# RESEND_API_KEY="re_..."
# Recipient for security alerts. Falls back to SMTP_USER when it is an email address.
# SECURITY_ALERT_EMAIL="you@example.com"
# Optional sender. With a Resend test key the default only delivers to your Resend account email.
# SECURITY_ALERT_FROM="AOS Security <onboarding@resend.dev>"
# SMTP (used automatically when RESEND_API_KEY is not set; works locally / paid Render)
# Telegram: create a bot with @BotFather, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Optional extra channel
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
# Set to "false" to disable temporary IP blocking (alerts keep working)
SECURITY_AUTO_BLOCK="true"
