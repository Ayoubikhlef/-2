{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src"],
  "exclude": [
    "src/app/api",
    "src/app/login",
    "src/app/local-sentry",
    "src/app/sentry-status",
    "src/lib/sentry.ts",
    "src/lib/sentry.server.ts",
    "src/lib/sentry.local.ts",
    "src/middleware.ts",
    "src/app/components/LiquidEther.tsx",
    "src/app/components/SocialLoginButtons.tsx"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
