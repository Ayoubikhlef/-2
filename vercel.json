{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "proxy": {
    "entrypoint": "proxy.ts"
  },
  "rewrites": [
    {
      "source": "/create-website",
      "destination": "/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://iueefgma6y.onrender.com/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://iueefgma6y.onrender.com/socket.io/$1"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/create-website",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,DELETE,PATCH,POST,PUT"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization"
        }
      ]
    },
    {
      "source": "/products/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-V8SbemcAZ/ltw1X/68mvtVldMLbDO+ejhGN/aUjUQmI=' 'sha256-PEF3EKwv1ZkxbnP6O0bcC5EXa3qVF0j9iEXHZ6/42uU=' https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://fonts.gstatic.com https://aos-api-production.up.railway.app wss://aos-api-production.up.railway.app https://iueefgma6y.onrender.com wss://iueefgma6y.onrender.com https://docs.google.com; worker-src 'self' blob:; frame-src https://www.google.com https://www.google.dz https://www.google.co.dz; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
